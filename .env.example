# Set this on the backend only. NEVER commit a real key.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
# Alternative:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# Required for admin-only source refresh:
SIIC_ADMIN_TOKEN=
# Optional SQLite location:
# SIIC_DB_PATH=/var/lib/siic/source_catalog.sqlite3
